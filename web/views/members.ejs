<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Üyeler — huw3s Guard</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<%- include('partials/navbar') %>
<div class="page-wrap">
  <%- include('partials/sidebar', { active: 'members' }) %>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>
  <main class="dash-main">

    <div class="page-header">
      <div class="page-title">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--p2)" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        Üye Listesi
      </div>
      <div class="page-sub">Son katılan 100 üye · Bot hesaplar hariç</div>
    </div>

    <div class="dc" style="margin-bottom:18px">
      <div class="dc-body" style="padding:14px 18px;display:flex;align-items:center;gap:14px;flex-wrap:wrap">
        <div style="position:relative;flex:1;min-width:220px;max-width:360px">
          <svg style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--text2)" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" id="memberSearch" class="form-control" placeholder="Kullanıcı adına göre ara…" style="padding-left:36px">
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <span class="badge badge-primary" id="totalBadge"><%= members.length %> üye</span>
          <span class="badge badge-danger"  id="adminBadge"><%= members.filter(m=>m.isAdmin).length %> admin</span>
          <span class="badge badge-success" id="wlBadge"><%= members.filter(m=>m.isWhitelisted).length %> whitelist</span>
        </div>
      </div>
    </div>

    <% if (!members.length) { %>
      <div class="empty-state" style="padding:80px">
        <div class="empty-state-icon">👥</div>
        <div class="empty-state-text">Üye bulunamadı. Botun <strong>Server Members</strong> yetkisinin açık olduğundan emin ol.</div>
      </div>
    <% } else { %>
      <div class="members-grid" id="memberGrid">
        <% for (const m of members) { %>
          <div class="member-card" data-tag="<%= m.tag.toLowerCase() %>">
            <div class="member-avatar-wrap">
              <img src="<%= m.avatar %>" class="member-avatar" alt="">
              <% if (m.isAdmin) { %>
                <span class="member-badge admin" title="Administrator">A</span>
              <% } else if (m.isWhitelisted) { %>
                <span class="member-badge wl" title="Whitelist">W</span>
              <% } %>
            </div>
            <div class="member-info">
              <div class="member-name"><%= m.tag %></div>
              <div class="member-meta">
                <span><%= m.roles %> rol</span>
                <span>·</span>
                <span><%= m.joinedAt ? new Date(m.joinedAt).toLocaleDateString('tr-TR') : '—' %></span>
              </div>
              <div class="member-tags">
                <% if (m.isAdmin)       { %><span class="badge badge-danger"  style="font-size:9px">Admin</span><% } %>
                <% if (m.isWhitelisted) { %><span class="badge badge-success" style="font-size:9px">WL</span><% } %>
              </div>
            </div>
            <a href="/dashboard/ceza/<%= m.id %>" class="btn btn-ghost btn-sm" style="flex-shrink:0">Geçmiş</a>
          </div>
        <% } %>
      </div>

      <div id="noResults" style="display:none">
        <div class="empty-state" style="padding:60px">
          <div class="empty-state-icon">🔍</div>
          <div class="empty-state-text">Arama sonucu bulunamadı.</div>
        </div>
      </div>
    <% } %>

  </main>
</div>

<script>
const nav = document.getElementById('nav');
window.addEventListener('scroll', () => nav?.classList.toggle('scrolled', scrollY > 10), { passive: true });

const overlay = document.getElementById('sidebarOverlay');
const sidebar = document.getElementById('sidebar');
document.getElementById('navMenuBtn')?.addEventListener('click', () => {
  sidebar.classList.toggle('open'); overlay.classList.toggle('show');
});
overlay?.addEventListener('click', () => {
  sidebar.classList.remove('open'); overlay.classList.remove('show');
});

document.getElementById('memberSearch')?.addEventListener('input', function () {
  const q = this.value.toLowerCase();
  const cards = document.querySelectorAll('.member-card');
  let visible = 0;
  cards.forEach(c => {
    const show = c.dataset.tag.includes(q);
    c.style.display = show ? '' : 'none';
    if (show) visible++;
  });
  document.getElementById('totalBadge').textContent = visible + ' üye';
  const noRes = document.getElementById('noResults');
  if (noRes) noRes.style.display = visible === 0 ? 'block' : 'none';
});
</script>
</body>
</html>
