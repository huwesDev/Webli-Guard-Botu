<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>huw3s Guard — Discord Sunucu Koruması</title>
  <meta name="description" content="19 koruma modülü, gerçek zamanlı log sistemi ve web panel entegrasyonuyla Discord sunucunuzu tam koruma altına alın.">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<%- include('partials/navbar') %>

<section class="hero">
  <div class="hero-bg"></div>
  <div class="hero-grid"></div>
  <canvas id="hero-canvas"></canvas>

  <div class="hero-inner">
    <div class="hero-chip sr">
      <span class="chip-dot"></span>
      v2.0 &nbsp;·&nbsp; Aktif &amp; Çalışıyor
    </div>

    <h1 class="hero-h1 sr d1">
      Sunucunuzu<br>
      <span class="line2">Güvende Tutun</span>
    </h1>

    <p class="hero-desc sr d2">
      19 koruma modülü, gerçek zamanlı log sistemi ve web panel entegrasyonuyla Discord sunucunuzu tam koruma altına alın.
    </p>

    <div class="hero-cta sr d3">
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/dashboard" class="btn btn-primary btn-xl">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
          Dashboard
        </a>
      <% } else { %>
        <a href="/auth/login" class="btn btn-primary btn-xl">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057.1 18.082.114 18.105.133 18.12a19.963 19.963 0 0 0 6.002 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>
          Discord ile Giriş Yap
        </a>
      <% } %>
      <a href="#features" class="btn btn-outline btn-xl">Özellikleri Keşfet</a>
    </div>

    <% if (typeof guild !== 'undefined' && guild) { %>
    <div class="hero-server sr d4">
      <% if (guild.iconURL()) { %><img src="<%= guild.iconURL() %>" alt="<%= guild.name %>"><% } %>
      <div>
        <div class="hero-server-name"><%= guild.name %></div>
        <div class="hero-server-meta">
          <span class="live"></span>
          <%= guild.memberCount.toLocaleString('tr-TR') %> üye &nbsp;·&nbsp; Aktif Koruma
        </div>
      </div>
    </div>
    <% } %>

    <div class="hero-numbers sr d5">
      <div>
        <div class="hero-num-val">19</div>
        <div class="hero-num-label">Koruma Modülü</div>
      </div>
      <div>
        <div class="hero-num-val">18</div>
        <div class="hero-num-label">Slash Komut</div>
      </div>
      <div>
        <div class="hero-num-val">%99.9</div>
        <div class="hero-num-label">Uptime</div>
      </div>
      <div>
        <div class="hero-num-val">24/7</div>
        <div class="hero-num-label">Aktif</div>
      </div>
    </div>
  </div>
</section>

<section class="section" id="features" style="background:var(--bg)">
  <div class="section-inner">
    <div class="section-head sr">
      <div class="tag">19 Modül</div>
      <h2 class="section-title">Her Tehdide Karşı Hazır</h2>
      <p class="section-sub">Sunucu güvenliğini uçtan uca kapsayan eksiksiz koruma sistemi.</p>
    </div>

    <div class="feat-grid">
      <%
        const feats = [
          ['ic-p', 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',                           'Rol Koruması',         'Silinen rolleri anında geri getirir, sorumluyu cezalandırır.'],
          ['ic-c', 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z',         'Kanal Koruması',       'Silinen/değiştirilen kanalları geri getirir. Kanal spam engeli.'],
          ['ic-pk','M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',                            'Sunucu Koruması',      'İsim, ikon ve banner değişikliklerini otomatik geri alır.'],
          ['ic-r', 'M3 11h18v11H3z M7 11V7a5 5 0 0 1 10 0v4',                                 'İzin Koruması',        'Rollere tehlikeli izin eklenmesini anında engeller.'],
          ['ic-o', 'M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z', 'Raid Koruması', 'Toplu katılım algılar, verification level yükseltir.'],
          ['ic-g', 'M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71',            'Link Filtresi',        'Davet & yetkisiz URL engeli. Whitelist domain desteği.'],
          ['ic-r', 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2',                              'Bot Koruması',         'Yetkisiz bot eklemelerini algılar, atar ve ekleyeni cezalandırır.'],
          ['ic-p', 'M22 16.92v3a2 2 0 0 1-2.18 2',                                            'Webhook Koruması',     'Yetkisiz webhook işlemlerini engeller ve siler.'],
          ['ic-c', 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z',         '@everyone Koruması',   '@everyone/@here kullanımını engeller ve ceza verir.'],
          ['ic-y', 'M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8',                              'Spam Guard',           'Hızlı mesaj spam ve klonlamayı tespit eder.'],
          ['ic-r', 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2',                              'Mention Guard',        '5+ mention içeren mesajları engeller.'],
          ['ic-pk','M4 7h16 M9 20h6 M12 4v16',                                                'Caps Guard',           '%70+ büyük harf mesajları siler.'],
          ['ic-c', 'M12 22c10-5 10-20 0-20S2 17 2 12',                                        'Auto Slowmode',        'Kanal spam anında otomatik slowmode.'],
          ['ic-o', 'M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z', 'Mass Action Guard', 'Toplu ban/kick tespitinde hesabı kilitler.'],
          ['ic-o', 'M12 20h9 M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 9.5-9.5z',       'Kelime Filtresi',      'Özelleştirilebilir yasaklı kelime listesi.'],
          ['ic-p', 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z',            'Gerçek Zamanlı Log',   'Tüm olaylar hem Discord hem web panele anında.'],
          ['ic-g', 'M21 15 21 21 3 21 3 15 M7 10 12 15 17 10 M12 15 12 3',                    'Yedekleme',            'Rol & kanal yapısını yedekler, geri yükler.'],
          ['ic-pk','M3 3h7v7H3z M14 3h7v7h-7z M14 14h7v7h-7z M3 14h7v7H3z',                  'Web Panel',            'Discord OAuth2 ile tüm ayarlar web üzerinden.'],
          ['ic-r', 'M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z',                           'Hesap Yaşı Koruması',  'Genç hesapların katılmasını engeller.'],
        ];
      %>
      <% feats.forEach(([ic, path, title, desc], i) => { %>
        <div class="feat-card sr" style="transition-delay:<%= (i % 4) * 0.07 %>s">
          <div class="feat-icon <%= ic %>">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="<%= path %>"/></svg>
          </div>
          <div class="feat-title"><%= title %></div>
          <div class="feat-desc"><%= desc %></div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<section class="section" id="komutlar" style="background:var(--bg2);border-top:1px solid var(--border)">
  <div class="section-inner">
    <div class="section-head sr">
      <div class="tag">18 Komut</div>
      <h2 class="section-title">Slash Komutlar</h2>
      <p class="section-sub">Otomatik tamamlama, yetki kontrolü ve zengin embed yanıtlarıyla.</p>
    </div>

    <div class="cmd-grid">
      <%
        const cmds = [
          ['/panel',         '19 koruma modülünü tek ekrandan yönet'],
          ['/userinfo',      'Kullanıcı detaylı bilgisi'],
          ['/sunucuinfo',    'Sunucu istatistikleri'],
          ['/istatistik',    'Guard & log istatistikleri'],
          ['/ban',           'Kullanıcı banla — DM bildirimiyle'],
          ['/kick',          'Kullanıcıyı sunucudan at'],
          ['/unban',         'ID ile ban kaldır'],
          ['/mute',          'Timeout (1dk → 1 hafta)'],
          ['/uyari',         'Uyarı ver / geçmiş gör'],
          ['/temizle',       '1–100 mesaj sil'],
          ['/kilit',         'Kanalı kilitle / aç'],
          ['/whitelist',     'Guard muafiyeti yönet'],
          ['/backup',        'Sunucu yapısını yedekle'],
          ['/otorol',        'Yeni üyelere otomatik rol'],
          ['/log-kanal',     'Log kanalını ayarla'],
          ['/jail-rol',      'Jail rolünü ayarla'],
          ['/hesap-yasi',    'Min. hesap yaşını ayarla'],
          ['/ceza-gecmis',   'Ceza geçmişini görüntüle'],
        ];
      %>
      <% cmds.forEach(([cmd, desc], i) => { %>
        <div class="cmd-card sr" style="transition-delay:<%= (i % 4) * 0.06 %>s">
          <code class="cmd-name"><%= cmd %></code>
          <div class="cmd-desc"><%= desc %></div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<section class="cta-section">
  <div class="sr" style="max-width:560px;margin:0 auto">
    <div class="tag" style="margin-bottom:14px">Hemen Başla</div>
    <h2 class="section-title" style="margin-bottom:12px">Sunucunuzu Şimdi Koruyun</h2>
    <p style="color:var(--text2);font-size:15px;margin-bottom:38px;line-height:1.78">
      Discord hesabınızla giriş yapın, saniyeler içinde tüm 19 modülü aktif edin.
    </p>
    <% if (typeof user !== 'undefined' && user) { %>
      <a href="/dashboard" class="btn btn-primary btn-xl">Dashboard'a Git →</a>
    <% } else { %>
      <a href="/auth/login" class="btn btn-primary btn-xl">Discord ile Giriş Yap →</a>
    <% } %>
  </div>
</section>

<footer class="footer">
  <a href="/" class="footer-brand">
    <div class="nav-logo" style="width:28px;height:28px;border-radius:8px">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
    </div>
    <span class="footer-brand-name">huw3s Guard</span>
  </a>
  <div class="footer-copy">© 2025 huw3s Guard System · Discord Sunucu Koruma Botu</div>
</footer>

<script>
const io = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
  });
}, { threshold: 0.07 });
document.querySelectorAll('.sr, .sr-l, .sr-r').forEach(el => io.observe(el));

const nav = document.getElementById('nav');
window.addEventListener('scroll', () => nav?.classList.toggle('scrolled', scrollY > 20), { passive: true });

(function () {
  const c = document.getElementById('hero-canvas');
  if (!c) return;
  const ctx = c.getContext('2d');
  function resize() { c.width = innerWidth; c.height = innerHeight; }
  resize();
  window.addEventListener('resize', resize, { passive: true });
  const pts = Array.from({ length: 60 }, () => ({
    x: Math.random() * innerWidth,
    y: Math.random() * innerHeight,
    r: 0.4 + Math.random() * 1.5,
    vx: (0.5 - Math.random()) * 0.16,
    vy: -0.05 - Math.random() * 0.18,
    a: 0.08 + Math.random() * 0.38,
  }));
  function draw() {
    ctx.clearRect(0, 0, c.width, c.height);
    pts.forEach(p => {
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(157,143,254,${p.a})`;
      ctx.fill();
      p.x += p.vx; p.y += p.vy;
      if (p.y < -5)           p.y = c.height + 5;
      if (p.x < -5)           p.x = c.width + 5;
      if (p.x > c.width + 5)  p.x = -5;
    });
    requestAnimationFrame(draw);
  }
  draw();
})();

document.querySelectorAll('a[href^="#"]').forEach(a => {
  a.addEventListener('click', e => {
    const t = document.querySelector(a.getAttribute('href'));
    if (t) { e.preventDefault(); t.scrollIntoView({ behavior: 'smooth' }); }
  });
});
</script>
</body>
</html>
