<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ban Listesi — huw3s Guard</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<%- include('partials/navbar') %>
<div class="page-wrap">
  <%- include('partials/sidebar', { active: 'bans' }) %>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>
  <main class="dash-main">

    <div class="page-header">
      <div class="page-title">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--red)" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
        Ban Listesi
      </div>
      <div class="page-sub"><%= bans.length %> kullanıcı banlı</div>
    </div>

    <% if (!bans.length) { %>
      <div class="dc">
        <div class="dc-body">
          <div class="empty-state" style="padding:80px">
            <div class="empty-state-icon">✅</div>
            <div class="empty-state-text">Ban listesi boş.</div>
          </div>
        </div>
      </div>
    <% } else { %>

      <div class="dc" style="margin-bottom:18px">
        <div class="dc-body" style="padding:14px 18px;display:flex;align-items:center;gap:14px;flex-wrap:wrap">
          <div style="position:relative;flex:1;min-width:220px;max-width:360px">
            <svg style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--text2)" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" id="banSearch" class="form-control" placeholder="Kullanıcı adına göre ara…" style="padding-left:36px">
          </div>
          <span class="badge badge-danger"><%= bans.length %> ban</span>
        </div>
      </div>

      <div class="dc">
        <div class="dc-head">
          <div class="dc-title">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
            Banlı Kullanıcılar
          </div>
        </div>
        <div class="dc-body" style="padding:14px">
          <div class="card-list" id="banList">
            <% for (const b of bans) { %>
              <div class="list-card ban-item" data-tag="<%= b.tag.toLowerCase() %>">
                <div class="list-card-avatar">
                  <img src="<%= b.avatar %>" alt="">
                </div>
                <div class="list-card-body">
                  <div class="list-card-title"><%= b.tag %></div>
                  <div class="list-card-sub">
                    <code><%= b.id %></code>
                    <span style="color:var(--text2);margin-left:6px">· <%= b.reason %></span>
                  </div>
                </div>
                <form action="/bans/unban" method="POST" style="flex-shrink:0">
                  <input type="hidden" name="userId" value="<%= b.id %>">
                  <button type="submit" class="btn btn-success btn-sm"
                          onclick="return confirm('Bu kullanıcının banını kaldırmak istediğinden emin misin?')">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                    Unban
                  </button>
                </form>
              </div>
            <% } %>
          </div>
          <div id="noBanResults" style="display:none">
            <div class="empty-state" style="padding:40px">
              <div class="empty-state-icon">🔍</div>
              <div class="empty-state-text">Arama sonucu bulunamadı.</div>
            </div>
          </div>
        </div>
      </div>

    <% } %>
  </main>
</div>

<script>
const nav = document.getElementById('nav');
window.addEventListener('scroll', () => nav?.classList.toggle('scrolled', scrollY > 10), { passive: true });

const overlay = document.getElementById('sidebarOverlay');
const sidebar = document.getElementById('sidebar');
document.getElementById('navMenuBtn')?.addEventListener('click', () => {
  sidebar.classList.toggle('open'); overlay.classList.toggle('show');
});
overlay?.addEventListener('click', () => {
  sidebar.classList.remove('open'); overlay.classList.remove('show');
});

document.getElementById('banSearch')?.addEventListener('input', function () {
  const q = this.value.toLowerCase();
  const items = document.querySelectorAll('.ban-item');
  let visible = 0;
  items.forEach(el => {
    const show = el.dataset.tag.includes(q);
    el.style.display = show ? '' : 'none';
    if (show) visible++;
  });
  const noRes = document.getElementById('noBanResults');
  if (noRes) noRes.style.display = visible === 0 ? 'block' : 'none';
});
</script>
</body>
</html>
